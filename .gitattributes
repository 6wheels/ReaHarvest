# Normalize text files to LF in the repository
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# REAPER fixtures must stay byte-exact (round-trip tests)
test/fixtures/** -text
*.rpp  -text
*.RPP  -text
*.RPP-bak -text
*.RTrackTemplate -text

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.webp binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.wav  binary
*.flac binary
*.mp3  binary
*.ogg  binary
*.mid  binary
*.pdf  binary
*.zip  binary
